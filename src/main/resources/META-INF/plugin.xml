<!-- Plugin Configuration File -->
<idea-plugin>
  <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
  <id>com.abugyda.dbd</id>

  <!-- Public plugin name should be written in Title Case.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
  <name>Database Diagram</name>
  <resource-bundle>messages.DatabaseDiagramBundle</resource-bundle>

  <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
  <vendor>Abugyda</vendor>

  <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
       Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
  <description><![CDATA[
      An Entity-Relation Diagram previewer and editor using SQL files and .erd.yaml layouts.
  ]]></description>

  <!-- Product and plugin compatibility requirements.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
  <depends>com.intellij.modules.platform</depends>

  <!-- Add this line! -->
  <!-- Add Dependencies for YAML and SQL Plugins -->
  <depends>org.jetbrains.plugins.yaml</depends>
  <depends>com.intellij.modules.sql</depends>

  <!-- Extensions defined by the plugin.
       Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
  <extensions defaultExtensionNs="com.intellij">

    <additionalTextAttributes scheme="Default" file="colorSchemes/DatabaseDiagramDefault.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colorSchemes/DatabaseDiagramDarcula.xml"/>
    <colorSettingsPage implementation="com.abugyda.dbd.settings.DatabaseDiagramColorSettingsPage"/>

    <applicationService serviceImplementation="com.abugyda.dbd.settings.DatabaseDiagramSettings"/>

    <applicationConfigurable
        parentId="tools"
        instance="com.abugyda.dbd.settings.DatabaseDiagramConfigurable"
        id="com.abugyda.dbd.settings.DatabaseDiagramConfigurable"
        bundle="messages.DatabaseDiagramBundle"
        key="configurable.database.diagram.display.name"/>

    <fileEditorProvider implementation="com.abugyda.dbd.editor.SchemaSplitEditorProvider"/>

    <!-- File template group — tells IntelliJ where to find the .ft files -->
    <fileTemplateGroup implementation="com.abugyda.dbd.templates.ErdFileTemplateGroup"/>

    <!--
      Internal file templates bundled with the plugin.
      `name`  must match the .ft filename (without extension) in
              src/main/resources/fileTemplates/
      The extension is NOT declared here because we control it ourselves in
      createFileFromTemplate() — the .erd.yaml double-extension needs special
      handling that IntelliJ's template system doesn't support natively.
    -->
    <internalFileTemplate name="ErdYaml"/>
    <internalFileTemplate name="SqlSchema"/>

  </extensions>

  <actions>
    <action id="com.abugyda.dbd.ConfigureDiagram"
            class="com.abugyda.dbd.actions.ConfigureDiagramAction"
            icon="AllIcons.General.Settings">
      <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>

    <group id="com.abugyda.dbd.NewFileGroup"
           popup="true"
           icon="AllIcons.FileTypes.Yaml">

      <action id="com.abugyda.dbd.NewErdYaml"
              class="com.abugyda.dbd.actions.NewErdYamlAction"
              icon="AllIcons.FileTypes.Yaml"/>

      <action id="com.abugyda.dbd.NewSqlSchema"
              class="com.abugyda.dbd.actions.NewSqlSchemaAction"
              icon="AllIcons.FileTypes.Text"/>

      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
    </group>
  </actions>

</idea-plugin>